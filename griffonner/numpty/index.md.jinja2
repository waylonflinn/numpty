{%- for name, member in mod.members.items() -%}
{%- if not member.is_alias and not name.startswith('_') -%}
{%- if member.kind.value == "class" %}{% set ns.classes = ns.classes + [member] %}{% endif -%}
{%- if member.kind.value == "function" %}{% set ns.functions = ns.functions + [member] %}{% endif -%}
{%- endif -%}
{%- endfor -%}
